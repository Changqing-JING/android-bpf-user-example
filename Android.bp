cc_binary {
    name: "bpfuser",
    srcs: ["bpfuser.cpp"],
    shared_libs: [
        "libbase",
        "libbpf_bcc",
        "libbpf_minimal",
        "liblog",
    ],
    header_libs: [
        "bpf_prog_headers",
        "bpf_headers",
    ],
    cflags: [
        "-Werror",
        "-Wall",
        "-Wextra",
    ],
    vendor: true
}

